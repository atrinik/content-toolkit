{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atrinik/content-toolkit/schemas/transaction-plan-v1",
  "title": "Revision-bound value replacement plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "expected_project_revision", "commands"],
  "properties": {
    "version": {"const": 1},
    "expected_project_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commands": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "expected_source_revision", "record", "expected_span", "semantic_intent", "replacement"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 240},
          "expected_source_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "record": {"type": "integer", "minimum": 0},
          "expected_span": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 0}
            }
          },
          "semantic_intent": {"type": "string", "minLength": 1, "maxLength": 1024},
          "replacement": {"type": "array", "maxItems": 1048576, "items": {"type": "integer", "minimum": 0, "maximum": 255}}
        }
      }
    }
  }
}
