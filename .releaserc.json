{
  "branches": [
    "+([0-9]).+([0-9]).x",
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": "./scripts/release/release-rules.cjs"
      }
    ],
    "./scripts/release/crate-pending.cjs",
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "python3 tools/crate_release.py finalize --source-tag v${nextRelease.version} --archives build/release",
        "successCmd": "python3 tools/crate_release.py dispatch --source-tag v${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "build/release/*"
          }
        ]
      }
    ]
  ]
}
